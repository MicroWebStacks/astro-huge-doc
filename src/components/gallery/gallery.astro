---
import {calculate_span,select_masonry} from './grid_utils.js'
import {getAssetUrl, getImageInfo} from '../../libs/structure-db.js';
import { config } from '@/config';
import ResponsivePreview from '../markdown/image/ResponsivePreview.astro';
import {imagePreview} from '../../libs/image-previews.js';

interface GalleryItem {
    uid: string;
}

export interface Props {
    model: GalleryItem[];
    masonry: boolean;
}

const { model, masonry=null } = Astro.props as Props;
const images_uids = model.map((item)=>(item.uid));
const imagesInfo = images_uids.map((uid)=>{
    const originalInfo = getImageInfo(uid) ?? {};
    const url = getAssetUrl(uid, config.collect.version_id);
    const preview = imagePreview(url, config);
    const info = preview ? {...originalInfo, width: preview.width, height: preview.height,
        ratio: preview.width / preview.height} : originalInfo;
    return {
        uid,
        url,
        ...info,
        ...calculate_span(info.ratio)
    }
}).filter((image) => image.url);

let mas = masonry
if(mas == null){
    mas = select_masonry(imagesInfo)
}

---

<div class={`pswp-gallery container ${mas?'masonry':'grid'}`}>
    {imagesInfo.map((image)=>(
        <a  href={image.url}
            class={`item  ${mas?'masonry':'grid'}`}
            style={`grid-area: span ${image.spanHeight} / span ${image.spanWidth};`}
            itemscope
            itemtype="http://schema.org/ImageGallery"
            data-gallery-image={image.uid}
            data-pswp-width={image.width} 
            data-pswp-height={image.height} >
                <ResponsivePreview src={image.url} width={image.width} height={image.height}
                    alt={image.alt ?? image.title ?? image.name ?? ''}
                    sizes={mas ? '(max-width: 40rem) 100vw, 20rem' : `(max-width: 48rem) 100vw, ${Math.max(1, image.spanWidth) * 10}rem`} />
        </a>
    ))}
</div>

<style>
.container.grid{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    grid-auto-rows: 10rem;
    grid-gap: var(--space-3);
}
.container :global(img){
    width: 100%;
    height: 100%;
    object-fit:cover;
}
.container.masonry{
    column-width: 20rem;
    column-gap: var(--space-4);
}
.item.masonry{
    break-inside: avoid;
    margin-bottom: var(--space-4);
}
</style>

<script src="./gallery.js" />
