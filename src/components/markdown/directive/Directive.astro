---
import ButtonDirective from './ButtonDirective.astro'
import DetailsDirective from './DetailsDirective.astro'
import IframeDirective from './IframeDirective.astro'

export interface Props {
  name: string;
  attributes: Record<string, string | boolean | null | undefined>;
}

const { name, attributes } = Astro.props as Props;
const is_image = (name == "image")
const is_button = (name == "button")
const is_details = (name?.toLowerCase() == "details")
const is_iframe = (name?.toLowerCase() == "iframe")
const is_other = !(is_image || is_button || is_details || is_iframe)
const otherAttributes = Object.entries(attributes ?? {})
const otherSuffix = otherAttributes.length
  ? `[]{${otherAttributes.map(([key, value]) => `${key}="${String(value)}"`).join(' ')}}`
  : ''

---
{is_button &&
  <ButtonDirective label={attributes.label} link={attributes.link} icon={attributes.icon} />
}
{is_details &&
  <DetailsDirective attributes={attributes} />
}
{is_iframe &&
  <IframeDirective attributes={attributes} />
}
{is_other &&
  <span>{`:${name}${otherSuffix}`}</span>
}
