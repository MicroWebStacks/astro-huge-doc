---
import './colors.css';
import Icon from "@/components/icon.astro"
import ThemeToggle from './ThemeToggle.astro';
import GraphModal from './GraphModal.astro';
import { buildAppBarMenu } from './layout_utils.js';
import { basePrefix } from '@/libs/blob-files.js';
import { config } from '@/config';

export interface Props {
    menu?: Array<{
        label: string;
        link: string;
        active_class?: string;
        align?: string;
        icon?: string;
    }>;
    showLeftToggle?: boolean;
    showRightToggle?: boolean;
    showRuntimeInfo?: boolean;
    showPreviewLock?: boolean;
    exploreEnabled?: boolean;
    logPage?: { url: string; title: string } | null;
    /** Concept id of the page in view; enables the neighborhood-graph icon. */
    graphSid?: string | null;
}

const { menu: providedMenu = [], showLeftToggle = false, showRightToggle = false, showRuntimeInfo = false, showPreviewLock = false, exploreEnabled = false, logPage = null, graphSid = null } = Astro.props as Props;
const menu = providedMenu.length ? providedMenu : buildAppBarMenu(Astro.url.pathname);
const prefix = basePrefix(config.base);
const logHref = logPage ? `${prefix}/${logPage.url}` : null;
const exploreHref = `${prefix}/explore`;
const left_side  = menu.filter((item)=>(!Object.hasOwn(item,"align") || !(item.align=="right")))
const right_side = menu.filter((item)=>(Object.hasOwn(item,"align") && (item.align=="right")))

---
<div class="navbar" data-appbar>
    <div class="navbar-primary">
    <ul class="navbar-leading">
        {showLeftToggle &&
            <li class="nav-toggle-item">
                <button id="nav-toggle-left" type="button" class="nav-toggle"
                    title="Toggle pages menu" aria-label="Toggle pages menu" aria-expanded="false">
                    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                        <rect x="1.5" y="2.5" width="13" height="11" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
                        <line x1="6" y1="2.5" x2="6" y2="13.5" stroke="currentColor" stroke-width="1.3"></line>
                        <rect class="fill" x="2.7" y="4.2" width="2" height="7.6" rx="0.6" fill="currentColor"></rect>
                    </svg>
                </button>
            </li>
        }
    </ul>
    <nav class="section-nav" aria-label="Primary sections" data-section-nav>
        <ul class="navbar-left">
            {left_side.map((item, index)=>(
            <li
                data-section-item={index}
                data-section-label={item.label}
                data-active-section={item.active_class === 'active' ? 'true' : 'false'}
            >
                <a
                    href={item.link}
                    class={item.active_class}
                    aria-current={item.active_class === 'active' ? 'page' : undefined}
                >
                    {item.label}
                    {item.icon && <Icon filename={item.icon} />}
                </a>
            </li>
            ))}
            <li class="section-overflow-trigger" data-section-overflow-trigger hidden>
                <button
                    type="button"
                    class="section-overflow-toggle"
                    data-section-overflow-toggle
                    aria-label="More sections"
                    aria-expanded="false"
                    aria-controls="section-overflow-panel"
                >
                    <span class="section-overflow-label" data-section-overflow-label>More</span>
                    <span class="section-overflow-count" data-section-overflow-count aria-hidden="true">0</span>
                    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                        <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </button>
            </li>
        </ul>
    </nav>
    </div>
    <ul class="navbar-right" data-utility-list>
        <li class="utility-overflow-trigger" data-utility-overflow-trigger hidden>
            <button
                type="button"
                class="nav-toggle utility-overflow-toggle"
                data-utility-overflow-toggle
                title="More tools"
                aria-label="More tools"
                aria-expanded="false"
                aria-controls="utility-overflow-panel"
            >
                <span>Tools</span>
                <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                    <path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </button>
        </li>
        {right_side.map((item)=>(
            <li class="utility-secondary utility-link-item" data-secondary-utility>
                <a
                    class="utility-link"
                    href={item.link}
                    target={item.link.startsWith('/')?"":"_blank"}
                    title={item.label}
                    aria-label={item.label}
                >
                    {item.icon && <Icon filename={item.icon} />}
                    <span class="utility-menu-label">{item.label}</span>
                </a>
            </li>
        ))}
        {logPage &&
            <li class="nav-toggle-item utility-secondary" data-secondary-utility>
                <a class="nav-toggle log-link" href={logHref}
                    title={`Knowledge log: ${logPage.title}`} aria-label="Knowledge log">
                    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                        <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
                        <polyline points="8,4.6 8,8 10.6,9.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></polyline>
                    </svg>
                    <span class="utility-menu-label">Knowledge log</span>
                </a>
            </li>
        }
        {exploreEnabled &&
            <li class="nav-toggle-item utility-secondary" data-secondary-utility>
                <a class="nav-toggle chrome-link" href={exploreHref}
                    title="Explore types, tags, and data issues" aria-label="Explore knowledge">
                    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                        <circle cx="6.4" cy="6.4" r="4.4" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
                        <line x1="9.7" y1="9.7" x2="13.7" y2="13.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
                        <circle cx="6.4" cy="6.4" r="1.2" fill="currentColor"></circle>
                    </svg>
                    <span class="utility-menu-label">Explore knowledge</span>
                </a>
            </li>
        }
        {graphSid &&
            <li class="nav-toggle-item graph-entry" data-secondary-utility data-name="graph"
                data-graph-root data-graph-sid={graphSid} data-graph-prefix={prefix}>
                <button type="button" class="nav-toggle" data-action="open-graph"
                    title="Neighborhood graph" aria-label="Show neighborhood graph">
                    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                        <circle cx="8" cy="3.2" r="1.9" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
                        <circle cx="3.2" cy="12.4" r="1.9" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
                        <circle cx="12.8" cy="12.4" r="1.9" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
                        <line x1="8" y1="5.1" x2="4" y2="10.6" stroke="currentColor" stroke-width="1.2"></line>
                        <line x1="8" y1="5.1" x2="12" y2="10.6" stroke="currentColor" stroke-width="1.2"></line>
                    </svg>
                    <span class="utility-menu-label">Neighborhood graph</span>
                </button>
                <GraphModal />
            </li>
        }
        {showRuntimeInfo &&
            <li class="nav-toggle-item utility-secondary" data-secondary-utility>
                <button id="runtime-info-toggle" type="button" class="nav-toggle"
                    title="Preview runtime info" aria-label="Preview runtime info" aria-expanded="false">
                    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                        <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
                        <circle cx="8" cy="5" r="0.9" fill="currentColor"></circle>
                        <line x1="8" y1="7.4" x2="8" y2="11.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></line>
                    </svg>
                    <span class="utility-menu-label">Preview runtime info</span>
                </button>
            </li>
        }
        {showPreviewLock &&
            <li class="nav-toggle-item utility-secondary" data-secondary-utility>
                <button id="preview-lock-toggle" type="button" class="nav-toggle" data-preview-lock-toggle
                    title="Lock preview to current page" aria-label="Lock preview to current page" aria-pressed="false">
                    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                        <rect x="3.5" y="7.3" width="9" height="6.2" rx="1.3" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
                        <path class="shackle-open" d="M5.7 7.3V5.2a2.3 2.3 0 0 1 4.4-1.6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
                        <path class="shackle-closed" d="M5.7 7.3V5.2a2.3 2.3 0 0 1 4.6 0v2.1" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path>
                        <circle class="fill" cx="8" cy="10.1" r="0.9" fill="currentColor"></circle>
                    </svg>
                    <span class="utility-menu-label">Preview lock</span>
                </button>
            </li>
        }
        <li data-utility-return-anchor hidden></li>
        <li class="theme-toggle-item">
            <ThemeToggle />
        </li>
        {showRightToggle &&
            <li class="nav-toggle-item">
                <button id="nav-toggle-right" type="button" class="nav-toggle"
                    title="Toggle outline" aria-label="Toggle outline" aria-expanded="false">
                    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
                        <rect x="1.5" y="2.5" width="13" height="11" rx="1.6" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
                        <line x1="10" y1="2.5" x2="10" y2="13.5" stroke="currentColor" stroke-width="1.3"></line>
                        <rect class="fill" x="11.3" y="4.2" width="2" height="7.6" rx="0.6" fill="currentColor"></rect>
                    </svg>
                </button>
            </li>
        }
    </ul>
    <div
        id="section-overflow-panel"
        class="appbar-disclosure section-overflow-panel"
        data-section-overflow-panel
        hidden
    >
        <nav aria-label="More sections">
            <ul>
                {left_side.map((item, index)=>(
                    <li data-section-overflow-item={index} hidden>
                        <a
                            href={item.link}
                            class={item.active_class}
                            aria-current={item.active_class === 'active' ? 'page' : undefined}
                        >
                            {item.label}
                            {item.icon && <Icon filename={item.icon} />}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
    <div
        id="utility-overflow-panel"
        class="appbar-disclosure utility-overflow-panel"
        data-utility-overflow-panel
        hidden
    >
        <span class="disclosure-heading">Tools</span>
        <ul data-utility-overflow-list></ul>
    </div>
</div>

<style>
.navbar{
    display:flex;
    align-items:stretch;
    position:relative;
    width:100%;
    max-width:100%;
    min-width:0;
}
.navbar-primary{
    display:flex;
    flex:1 1 auto;
    min-width:0;
    overflow:hidden;
}
.navbar-leading{
    display:flex;
    flex:0 0 auto;
}
.section-nav{
    flex:1 1 auto;
    min-width:0;
    overflow:hidden;
}
.navbar-left {
    display:flex;
    flex-direction:row;
    flex-wrap:nowrap;
    width:max-content;
    min-width:0;
}
.navbar-right {
    display:flex;
    flex:0 0 auto;
    flex-direction:row;
    flex-wrap:nowrap;
    padding-right:0;
}

ul{
    margin:0px;
    padding:0px;
}
li{
    list-style: none;
}
li[hidden],
.appbar-disclosure[hidden]{
    display:none;
}

a{
    float:left;
    font-size: var(--text-base);
    padding: var(--space-3) var(--space-4);
    text-align:center;
    color: var(--content-color);
	text-decoration: none;

}
a:hover{
    background-color: var(--header-active-color);
}
a.active{
    border:0px;
    border-bottom:  3px solid var(--content-color-faint);
    background-color: var(--header-active-color);
}
.section-overflow-trigger{
    display:flex;
    align-items:stretch;
}
.section-overflow-toggle{
    display:flex;
    align-items:center;
    gap:var(--space-1);
    border:0;
    border-bottom:3px solid transparent;
    padding:var(--space-3) var(--space-4);
    background:transparent;
    color:var(--content-color);
    font:inherit;
    white-space:nowrap;
    cursor:pointer;
}
.section-overflow-toggle:hover,
.section-overflow-trigger.disclosure-open .section-overflow-toggle{
    background-color:var(--header-active-color);
}
.section-overflow-toggle:focus-visible{
    outline:2px solid var(--front-blue);
    outline-offset:-2px;
}
.section-overflow-count{
    min-width:1.25rem;
    padding-inline:var(--space-1);
    border-radius:999px;
    background:var(--surface-2-bg);
    color:var(--content-color-muted);
    font-size:var(--text-sm);
    line-height:1.25rem;
}
.section-compact .section-overflow-toggle{
    max-width:100%;
}
.section-compact .section-overflow-label{
    max-width:min(14rem, 100%);
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}
.appbar-disclosure{
    position:absolute;
    top:calc(100% + 1px);
    z-index:30;
    box-sizing:border-box;
    min-width:12rem;
    max-width:min(24rem, calc(100vw - (2 * var(--space-2))));
    max-height:min(70vh, 30rem);
    overflow:auto;
    padding:var(--space-1);
    border:1px solid var(--soft-border-color);
    border-radius:var(--radius-sm);
    background:var(--nav-bg-color);
    box-shadow:var(--shadow-raised);
}
.appbar-disclosure li{
    display:block;
}
.appbar-disclosure li[hidden]{
    display:none;
}
.appbar-disclosure a,
.appbar-disclosure .nav-toggle{
    display:flex;
    float:none;
    align-items:center;
    justify-content:flex-start;
    gap:var(--space-2);
    box-sizing:border-box;
    width:100%;
    min-height:44px;
    margin:0;
    padding:var(--space-2) var(--space-3);
    border:0;
    border-radius:var(--radius-sm);
    text-align:left;
    white-space:normal;
}
.appbar-disclosure a.active{
    border-left:3px solid var(--front-blue);
    border-bottom:0;
}
.appbar-disclosure a:focus-visible{
    outline:2px solid var(--front-blue);
    outline-offset:-2px;
}
.utility-overflow-panel{
    right:var(--space-1);
}
.disclosure-heading{
    display:block;
    padding:var(--space-2) var(--space-3) var(--space-1);
    color:var(--content-color-muted);
    font-size:var(--text-sm);
    font-weight:600;
}
.utility-menu-label{
    display:none;
}

.navbar-right > li > a{
    float:right;
    padding: var(--space-2);
}
.utility-link{
    display:flex;
    align-items:center;
    justify-content:center;
    box-sizing:border-box;
    min-width:44px;
    min-height:44px;
}
.theme-toggle-item{
    display:flex;
    align-items:center;
}

/* Knowledge-log link (OKF plan DD-8): shares the toggle-button footprint but
   navigates instead of toggling; neutralize the generic app-bar <a> rules. */
a.log-link,
a.chrome-link{
    float:none;
    padding:var(--space-2);
}

/* Side-menu toggles — the app bar is the single authority for opening and
   closing the page tree (left) and outline (right). */
.nav-toggle-item{
    display:flex;
    align-items:center;
}
.nav-toggle{
    display:flex;
    align-items:center;
    justify-content:center;
    background:transparent;
    border:0;
    border-radius:var(--radius-sm);
    margin:var(--space-1) 2px;
    padding:var(--space-2);
    color:var(--content-color-muted);
    cursor:pointer;
    min-width:2.75rem;
    min-height:2.75rem;
}
.nav-toggle:hover{
    background-color:var(--header-active-color);
    color:var(--content-color);
}
/* display:flex above outranks the UA's [hidden]{display:none}, so a toggle
   hidden from script (the preview lock outside the webview) would otherwise
   stay visible — and dead, since its script returns before binding. */
.nav-toggle[hidden]{
    display:none;
}
.nav-toggle:focus-visible{
    outline:2px solid var(--front-blue);
    outline-offset:2px;
}
/* Open state: accent the icon and light its sidebar cell so the button
   reads as "panel is showing". */
.nav-toggle[aria-expanded="true"]{
    color:var(--content-color);
}
.nav-toggle[aria-expanded="true"] .fill{
    fill:var(--front-blue);
}
.nav-toggle[aria-expanded="false"] .fill{
    opacity:0;
}
/* Neighborhood graph (OKF plan TP-13/DD-11, ruling R-16): a public discovery
   affordance, so it lives with the other chrome icons instead of behind a
   click in the footer. The dedicated live modal stays inside the same root so
   graph_entry.js can own the renderer lifecycle without static SVG cloning. */
.graph-entry{
    position:relative;
}
.graph-entry .nav-toggle[aria-busy="true"]{
    opacity:0.6;
    cursor:progress;
}
/* Preview lock toggle (webview-only): shackle swaps open/closed and the
   keyhole dot accents blue when locked, mirroring the menu-toggle pattern. */
.nav-toggle[aria-pressed="true"] .shackle-open,
.nav-toggle[aria-pressed="false"] .shackle-closed{
    display:none;
}
.nav-toggle[aria-pressed="true"] .fill{
    fill:var(--front-blue);
}
@media only screen and (max-width: 700px) {
    a{
        padding-inline:var(--space-3);
    }
    .navbar-right > [data-secondary-utility]{
        display:none;
    }
    .utility-overflow-panel [data-secondary-utility]{
        display:block;
    }
    .utility-overflow-panel .utility-menu-label{
        display:inline;
    }
    .section-overflow-toggle{
        padding-inline:var(--space-3);
    }
    .nav-toggle{
        margin:0;
        min-width:44px;
        min-height:44px;
    }
    .utility-overflow-toggle{
        gap:var(--space-1);
        width:auto;
        padding-inline:var(--space-2);
    }
    .theme-toggle-item :global(.theme-toggle){
        min-width:44px;
        min-height:44px;
        margin:0;
    }
}
</style>
<script src="../components/panzoom/panzoom_common.js" />
<script src="./graph_entry.js" />
<script src="./appbar_overflow.js" />
