---
---
<aside class="lite-index-status" data-state="waiting" data-collapsed="true">
    <div class="index-body" id="index-status-body" aria-live="polite">
        <div class="index-summary">
            <span class="index-dot" aria-hidden="true"></span>
            <span data-index-label>Link index waiting for first render</span>
        </div>
        <progress data-index-progress max="1" value="0" aria-label="Link indexing progress"></progress>
        <div class="index-actions">
            <button type="button" data-index-action="pause">Pause</button>
            <button type="button" data-index-action="stop">Stop</button>
        </div>
    </div>
    <button type="button" class="index-handle" data-index-toggle aria-controls="index-status-body"
        aria-expanded="false" title="Show link index status" aria-label="Show link index status">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M4 6.5 8 10.5 12 6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
</aside>
<style>
.lite-index-status{
    --index-toggle-inset:var(--space-3);
    --index-toggle-width:1.9rem;
    --index-toggle-height:var(--index-status-handle);
    position:fixed;
    z-index:30;
    left:0;
    right:0;
    bottom:0;
    min-height:var(--index-status-height);
    box-sizing:border-box;
    display:block;
    padding:var(--space-1) var(--space-3);
    border-top:1px solid var(--soft-border-color);
    background:var(--nav-bg-color);
    color:var(--content-color-muted);
    box-shadow:var(--shadow-raised);
    font-size:var(--text-sm);
    transform:translateY(0);
    transition:transform 0.25s ease;
}
/* Collapsed: the bar slides the full way down and the handle — attached to its
   top edge — rides along, coming to rest against the viewport edge. One
   control the whole way, moved by the same animation, rather than a chevron
   that vanishes and a tab that appears where it used to be. */
.lite-index-status[data-collapsed="true"]{
    transform:translateY(100%);
}
.index-body{
    display:grid;
    grid-template-columns:minmax(12rem,auto) minmax(6rem,20rem) auto;
    align-items:center;
    gap:var(--space-3);
    /* Off-screen alone does not hide content from a screen reader; visibility
       does. Transitioned so it goes at the end of the slide, not at its start. */
    visibility:visible;
    transition:visibility 0.25s ease;
}
.lite-index-status[data-collapsed="true"] .index-body{
    visibility:hidden;
}
.index-summary{display:flex;align-items:center;gap:var(--space-2);min-width:0}
.index-dot{width:.55rem;height:.55rem;border-radius:50%;background:var(--content-color-faint);flex:none}
[data-state="running"] .index-dot{background:var(--front-blue);animation:index-pulse 1s ease-in-out infinite alternate}
[data-state="complete"] .index-dot{background:var(--front-green, #22c55e)}
[data-state="paused"] .index-dot{background:var(--front-orange, #f59e0b)}
[data-state="stopped"] .index-dot{background:var(--content-color-faint)}
progress{width:100%;height:.45rem;accent-color:var(--front-blue)}
.index-actions{display:flex;align-items:center;justify-content:flex-end;gap:var(--space-1);justify-self:end}
button{border:1px solid var(--soft-border-color);border-radius:var(--radius-sm);padding:.2rem .55rem;background:transparent;color:var(--content-color);cursor:pointer}
button:hover{background:var(--menu-span-hover-color)}
button[hidden]{display:none}
/* The handle sits on the bar's top edge, so the bar can travel its whole
   height without taking the control off screen with it. */
.index-handle{
    position:absolute;
    /* 1px into the bar's own top border, so the line breaks around the handle
       and the two read as one shape rather than a button resting on a shelf. */
    bottom:calc(100% - 1px);
    right:var(--index-toggle-inset);
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:var(--index-toggle-width);
    height:var(--index-toggle-height);
    padding:0;
    border:1px solid var(--soft-border-color);
    border-bottom:0;
    border-radius:var(--radius-sm) var(--radius-sm) 0 0;
    background:var(--nav-bg-color);
    color:var(--content-color-muted);
    box-shadow:var(--shadow-raised);
}
.index-handle:hover{color:var(--content-color);background:var(--menu-span-hover-color)}
.index-handle:focus-visible{outline:2px solid var(--front-blue);outline-offset:1px}
.index-handle svg{transition:transform 0.18s ease}
/* Chevron points the way the bar will go: down closes it, up brings it back. */
.lite-index-status[data-collapsed="true"] .index-handle svg{transform:rotate(180deg)}
@keyframes index-pulse{from{opacity:.45}to{opacity:1}}
@media (prefers-reduced-motion:reduce){
    [data-state="running"] .index-dot{animation:none}
    .lite-index-status{transition:none}
    .index-body{transition:none}
}
@media (max-width:700px){.index-body{grid-template-columns:1fr auto}.index-body progress{grid-column:1/-1;grid-row:2}.index-summary{overflow:hidden}.index-summary span:last-child{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}}
</style>
<script src="./lite_relation_indexer.js" />
