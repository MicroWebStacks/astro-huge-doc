---
/*
 * Site footer (homesmartmesh-parity WP-17).
 *
 * Deliberately content-driven and off by default. The reference deployment has
 * no footer, so parity requires none; inventing branding here would put text on
 * every page that nobody asked for. Instead the capability ships and the
 * manifest decides:
 *
 *   render:
 *     footer:
 *       text: "© HomeSmartMesh"
 *       href: "https://github.com/HomeSmartMesh"   # optional
 *
 * With no `render.footer` key, nothing renders and the layout is unchanged.
 * Distinct from RelationsFooter, which is per-page relations inside the
 * article; this is a site-wide strip outside the scrolling column.
 */
import { config } from '@/config';

const footer = (config as any).render?.footer ?? null;
const text = typeof footer === 'string' ? footer : (typeof footer?.text === 'string' ? footer.text : '');
const href = typeof footer?.href === 'string' ? footer.href : '';
const show = text.trim().length > 0;
---
{show &&
    <footer class="site-footer">
        {href
            ? <a href={href} rel="noreferrer">{text}</a>
            : <span>{text}</span>}
    </footer>
}
<style>
.site-footer{
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-1) var(--space-3);
    border-top: 1px solid var(--soft-border-color);
    background-color: var(--nav-bg-color);
    color: var(--content-color-muted);
    font-size: var(--text-sm);
    user-select: none;
}
.site-footer a{
    color: inherit;
    text-decoration: none;
}
.site-footer a:hover{
    color: var(--article-anchor-color);
    text-decoration: underline;
}
:global(html[data-preview-mode="true"]) .site-footer{
    display: none;
}
</style>
