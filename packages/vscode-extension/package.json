{
  "name": "markdown-site-preview",
  "displayName": "Markdown Site Preview",
  "description": "Browse your whole Markdown documentation like a website — Mermaid/PlantUML diagrams, tables, file tree and outline navigation.",
  "version": "0.0.27",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1E1B4B",
    "theme": "dark"
  },
  "keywords": [
    "markdown",
    "preview",
    "diagrams",
    "mermaid",
    "plantuml",
    "documentation",
    "tables",
    "site",
    "kroki"
  ],
  "engineVersion": "0.0.23",
  "publisher": "microwebstacks",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MicroWebStacks/astro-huge-doc.git",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://github.com/MicroWebStacks/astro-huge-doc/tree/main/packages/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/MicroWebStacks/astro-huge-doc/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "microwebstacks.previewDocs",
        "title": "Markdown Site Preview: Open Preview",
        "icon": "$(globe)"
      },
      {
        "command": "microwebstacks.restartDocsPreviewServer",
        "title": "Markdown Site Preview: Restart Server"
      },
      {
        "command": "microwebstacks.stopDocsPreviewServer",
        "title": "Markdown Site Preview: Stop Server"
      },
      {
        "command": "microwebstacks.internal.lockDocsPreview",
        "title": "Preview Lock",
        "icon": "$(unlock)"
      },
      {
        "command": "microwebstacks.internal.unlockDocsPreview",
        "title": "Preview Unlock",
        "icon": "$(lock)"
      }
    ],
    "keybindings": [
      {
        "command": "microwebstacks.previewDocs",
        "key": "ctrl+k m",
        "when": "editorLangId == markdown"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "microwebstacks.internal.lockDocsPreview",
          "when": "false"
        },
        {
          "command": "microwebstacks.internal.unlockDocsPreview",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "microwebstacks.previewDocs",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Site Preview",
      "properties": {
        "microwebstacks.preview.enginePath": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Development override: path to an astro-huge-doc repository checkout used instead of the engine bundled in the extension."
        },
        "microwebstacks.preview.docsRoot": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Optional path to the documentation root inside the workspace. Defaults to manifest render.folder when set, otherwise output.content, otherwise the workspace folder."
        },
        "microwebstacks.preview.krokiServer": {
          "type": "string",
          "scope": "resource",
          "default": "http://localhost:18000",
          "markdownDescription": "Base URL of the Kroki-compatible server used for BlockDiag and explicitly Kroki-routed diagram languages. Mermaid and PlantUML render client-side in the preview with no external setup. Use a local Docker Kroki (`http://localhost:18000`), the public service (`https://kroki.io`), or your organization's internal endpoint. Leave blank to fall back to the workspace `.env` or environment."
        }
      }
    }
  }
}
